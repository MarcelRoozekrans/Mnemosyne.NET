<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Minos.NET.SystemOne" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\schemas\reasonlet-graph.v1.schema.json" Link="schemas\reasonlet-graph.v1.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The frozen graph schema v1 golden documents. -->
    <None Include="Graph\GoldenV1\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The telemetry capture the Docker tier uses, so both tiers listen and filter the same way. -->
    <Compile Include="..\Mnemosyne.NET.PostgreSql.Tests\TelemetryCapture.cs" Link="PostgreSql\TelemetryCapture.cs" />
    <!-- The sample's hashing embedding generator, compiled in rather than referenced: the sample is an Exe. -->
    <Compile Include="..\..\samples\Shared\HashingEmbeddingGenerator.cs" Link="Samples\HashingEmbeddingGenerator.cs" />
    <Compile Include="..\..\samples\Shared\ScriptedChatClient.cs" Link="Samples\ScriptedChatClient.cs" />
    <Compile Include="..\..\samples\Shared\CaptureRunWatcher.cs" Link="Samples\CaptureRunWatcher.cs" />
    <Compile Include="..\..\samples\Shared\SampleRunner.cs" Link="Samples\SampleRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mnemosyne.NET.Abstractions\Mnemosyne.NET.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Mnemosyne.NET.AgentFramework\Mnemosyne.NET.AgentFramework.csproj" />
    <ProjectReference Include="..\..\src\Mnemosyne.NET.Minos\Mnemosyne.NET.Minos.csproj" />
    <ProjectReference Include="..\..\src\Mnemosyne.NET.Sentinel\Mnemosyne.NET.Sentinel.csproj" />
    <ProjectReference Include="..\..\src\Mnemosyne.NET.PostgreSql\Mnemosyne.NET.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Mnemosyne.NET\Mnemosyne.NET.csproj" />
  </ItemGroup>
</Project>
