<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\schemas\reasonlet-graph.v1.schema.json" Link="schemas\reasonlet-graph.v1.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The telemetry capture the Docker tier uses, so both tiers listen and filter the same way. -->
    <Compile Include="..\Mnemosyne.NET.PostgreSql.Tests\TelemetryCapture.cs" Link="PostgreSql\TelemetryCapture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mnemosyne.NET.Abstractions\Mnemosyne.NET.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Mnemosyne.NET.PostgreSql\Mnemosyne.NET.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Mnemosyne.NET\Mnemosyne.NET.csproj" />
    <!-- For the sample's hashing embedding generator, whose tests live here; coverage.config.xml excludes the sample. -->
    <ProjectReference Include="..\..\samples\Mnemosyne.Samples.StoreAndRecall\Mnemosyne.Samples.StoreAndRecall.csproj" />
  </ItemGroup>
</Project>
