<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Mnemosyne.NET.Abstractions/Mnemosyne.NET.Abstractions.csproj" />
    <ProjectReference Include="../../src/Mnemosyne.NET/Mnemosyne.NET.csproj" />
    <ProjectReference Include="../../src/Mnemosyne.NET.Minos/Mnemosyne.NET.Minos.csproj" />
    <ProjectReference Include="../../src/Mnemosyne.NET.PostgreSql/Mnemosyne.NET.PostgreSql.csproj" />
  </ItemGroup>

  <!-- Rooting, not calling, is what makes the trimmer and AOT compiler analyze every package in full. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Mnemosyne.NET.Abstractions" />
    <TrimmerRootAssembly Include="Mnemosyne.NET" />
    <TrimmerRootAssembly Include="Mnemosyne.NET.Minos" />
    <TrimmerRootAssembly Include="Mnemosyne.NET.PostgreSql" />
  </ItemGroup>

</Project>
