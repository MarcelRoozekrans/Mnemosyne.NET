.claude/scheduled_tasks.lock
.claude/worktrees/
.worktrees/

# Screenshots and page snapshots the Playwright MCP server writes into the working directory.
.playwright-mcp/

# Docusaurus
node_modules/
/build/
/.docusaurus/
