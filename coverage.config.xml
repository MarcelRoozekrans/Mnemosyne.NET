<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings for CI, passed to the test apps with the coverage-settings option. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]Mnemosyne\.NET[^\\/]*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*Tests\.dll$</ModulePath>
        <ModulePath>.*AotSmoke\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
    <!-- Generated code says nothing about test quality. CompilerGeneratedAttribute is deliberately NOT
         excluded: the compiler puts it on every async and iterator state machine, so excluding it hides
         the bodies of all async methods from coverage. Source-generator output is excluded by
         GeneratedCodeAttribute and by the obj/ and .g.cs source rules below. -->
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
        <Source>.*\.g\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
