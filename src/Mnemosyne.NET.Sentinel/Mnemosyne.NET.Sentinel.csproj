<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- AI.Sentinel pulls in ZeroAlloc.Authorization, whose bundled generator flows in transitively despite AI.Sentinel's
         exclude="Analyzers". It would emit a public, undocumented registration type into this assembly, which would collide
         with a host app's own. The guard declares no policies, so it uses the package's own switch to drop that generator.
         Remove the switch only if the fix for ZeroAlloc-Net/ZeroAlloc.Authorization#181 stops the generator emitting the
         registration type into libraries that declare no policies; documenting the type would still emit it. -->
    <ZeroAllocAuthorizationDisableBundledAnalyzer>true</ZeroAllocAuthorizationDisableBundledAnalyzer>
    <Description>A capture guard that runs AI.Sentinel's detectors before a Reasonlet is stored.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mnemosyne.NET.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AI.Sentinel" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mnemosyne.NET.Abstractions\Mnemosyne.NET.Abstractions.csproj" />
  </ItemGroup>
</Project>
