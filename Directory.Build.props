<Project>
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Shared NuGet package metadata. Description is deliberately NOT set here: each .csproj owns its own. -->
  <PropertyGroup>
    <Authors>Marcel Roozekrans</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MarcelRoozekrans/Mnemosyne.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MarcelRoozekrans/Mnemosyne.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ai;agents;memory;procedural-memory;reasonlets;embeddings;pgvector;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Debugging into the package: Go to Definition and step-into show the original source.
       The PDB is embedded in each DLL, so consumers need no symbol server setting; Source Link,
       built into the .NET SDK, maps it to this commit on GitHub. ContinuousIntegrationBuild
       makes CI builds deterministic and writes /_/ paths instead of the runner's. It applies to
       the shipped projects under src/ only: in a test project it would also turn CallerFilePath
       into /_/..., which breaks tests that find snapshot files through it. -->
  <PropertyGroup>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' and $(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packs each project's OWN README.md, beside its .csproj. There is no root fallback: a
         packable project without its own README fails pack (NU5039). -->
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
