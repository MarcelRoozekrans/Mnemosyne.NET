<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AdoNet.Async" Version="1.5.6" />
    <PackageVersion Include="AdoNet.Async.Adapters" Version="1.4.0" />
    <PackageVersion Include="AI.Sentinel" Version="4.2.0" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <!-- 18.0.x is the last line on Microsoft.Testing.Platform v1, which xunit.v3 3.x runs on. 18.1 and
         later need platform v2, so this moves together with the xunit.v3 4.x bump. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.0.6" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Minos.NET" Version="1.3.0" />
    <PackageVersion Include="Minos.NET.SystemOne" Version="1.3.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="ZeroAlloc.ORM" Version="2.10.0" />
    <PackageVersion Include="ZeroAlloc.ORM.Generator" Version="2.10.0" />
    <PackageVersion Include="ZeroAlloc.Results" Version="1.4.5" />
  </ItemGroup>
</Project>
